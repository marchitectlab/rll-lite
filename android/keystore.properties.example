# Copy this file to keystore.properties (same folder: android/keystore.properties)
# Fill in your production keystore details — never commit the real file to git.
#
# storeFile: path to your .jks or .keystore file, relative to the android/ folder
#            e.g. ../my-release-key.jks  (if keystore lives next to android/)
#            e.g. app/my-release-key.jks (if keystore lives inside android/app/)
#
storeFile=../my-release-key.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
